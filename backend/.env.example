APP_NAME="HR Chan API"
DATABASE_URL=postgresql+asyncpg://hr_chan:local_dev_only@localhost:5432/hr_chan
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Authentication. Both secrets are required before any credential endpoint works;
# /health stays available without them. Generate each value separately, for example
# with `openssl rand -base64 48`, and never commit the result.
JWT_SECRET=
LIMITER_SECRET=
JWT_ISSUER=hr-chan-api
JWT_AUDIENCE=hr-chan-web
ACCESS_TOKEN_TTL_SECONDS=300

# Browser and email settings.
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGINS=["http://localhost:5173"]
ALLOWED_EMAIL_DOMAINS=["sis.hust.edu.vn"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session lifetimes and throttling values (seconds unless named otherwise).
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
INVITATION_TTL_SECONDS=86400
RECOVERY_TTL_SECONDS=1800
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_IP_LIMIT=50
LOGIN_IP_WINDOW_SECONDS=900
RECOVERY_IP_LIMIT=20
RECOVERY_IP_WINDOW_SECONDS=3600
EMAIL_MIN_INTERVAL_SECONDS=60
EMAIL_HOURLY_LIMIT=5

# Email. EMAIL_PROVIDER=smtp sends through SMTP_HOST (Mailpit locally: port 1025, no
# TLS); EMAIL_PROVIDER=fake only simulates and delivers nothing. Left empty, the provider
# is smtp when SMTP_HOST is set and fake otherwise. Never enable TLS and SSL together.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, an App Password.
# Legacy names SMTP_STARTTLS, SMTP_FROM_EMAIL and SMTP_FROM_NAME are still accepted.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
MAIL_FROM_ADDRESS=no-reply@sis.hust.edu.vn
MAIL_FROM_NAME="HR Chan"

# Email outbox. OUTBOX_ENCRYPTION_KEY (at least 32 characters, generate your own and
# keep it stable) encrypts secrets of queued mail; it has no default and is only needed
# once mail with secrets is queued. The worker delivers queued mail every
# EMAIL_OUTBOX_INTERVAL_SECONDS, at most EMAIL_OUTBOX_BATCH_SIZE messages per run.
OUTBOX_ENCRYPTION_KEY=
EMAIL_OUTBOX_INTERVAL_SECONDS=30
EMAIL_OUTBOX_BATCH_SIZE=20

# Candidate applications. Every secret below has no default: generate each one separately
# (at least 32 characters, e.g. `openssl rand -base64 48`), keep it stable across restarts
# and never commit it. While a value is missing the related endpoint answers 503;
# /health keeps working.
# CV_STORAGE_DIR must be a private directory outside the repository's public/static
# folders (for example an absolute path such as /var/lib/hr-chan/cv). Files are stored
# AES-GCM encrypted under random names; changing CV_ENCRYPTION_KEY makes them unreadable.
CV_STORAGE_DIR=
CV_ENCRYPTION_KEY=
SUBMISSION_TOKEN_SECRET=
OTP_SECRET=
CONSENT_POLICY_VERSION=2026-11
# Cloudflare Turnstile server-side verification. Without the secret the upload answers
# 503 (CAPTCHA is never skipped). Optional expected hostname/action are checked when set.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
# ClamAV clamd on loopback: docker compose --profile scan up -d
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
# Worker cleanup of unused CVs (24 h) and stale OTP codes, in seconds.
APPLICATION_CLEANUP_INTERVAL_SECONDS=3600
CV_SCORING_INTERVAL_SECONDS=30
CV_SCORING_TIMEOUT_SECONDS=10

# Candidate-facing links in interview and consent email.
PUBLIC_BASE_URL=http://localhost:5173
# HR supplies the start time. The server derives the end time.
INTERVIEW_DURATION_MINUTES=60

# Only enable behind configured proxies that overwrite forwarded IP headers.
TRUST_FORWARDED_FOR=false

# Development only: allows `uv run python -m app.cli seed-dev-accounts` to create
# the quick-login fixture accounts. Never enable it for real account data.
DEV_SEED_ENABLED=false

# Development only: exposes POST /auth/dev-login, which opens a session for the
# fixed `dev.*` personas without a password. Requires the backend to run locally
# and must never be enabled where real accounts exist.
DEV_LOGIN_ENABLED=false

# Job expiry worker, run as a separate process: `uv run python -m app.worker`.
# Seconds between sweeps that close OPEN postings past their deadline (must be > 0).
JOB_EXPIRY_INTERVAL_SECONDS=60
