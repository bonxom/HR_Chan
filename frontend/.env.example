# Leave empty to use the same-origin /api dev proxy (recommended: refresh cookies
# stay same-site). Set an absolute backend URL only for a cross-origin deployment
# that also lists this origin in the backend CORS and trusted origins.
VITE_API_BASE_URL=

# Site key công khai của Cloudflare Turnstile cho form ứng tuyển. Để trống thì form không
# thể gửi (không có đường bỏ qua CAPTCHA). Local/E2E có thể dùng site key test công khai
# của Cloudflare (1x00000000000000000000AA); production phải dùng khóa riêng của site.
VITE_TURNSTILE_SITE_KEY=
